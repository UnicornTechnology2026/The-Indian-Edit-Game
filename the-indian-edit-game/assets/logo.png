<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 140" width="100%" height="100%">
  <defs>
    <linearGradient id="logoGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff0b8"/>
      <stop offset="35%" stop-color="#eec765"/>
      <stop offset="70%" stop-color="#cf9f2e"/>
      <stop offset="100%" stop-color="#8a671a"/>
    </linearGradient>
    <filter id="goldGlow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
  </defs>
  <!-- Top line: THE -->
  <text x="250" y="32" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" font-size="20" font-weight="700" fill="url(#logoGold)" filter="url(#goldGlow)" text-anchor="middle" letter-spacing="8">THE</text>
  
  <!-- Main word: INDIAN -->
  <g transform="translate(250, 82)">
    <text x="0" y="0" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" font-size="52" font-weight="700" fill="url(#logoGold)" filter="url(#goldGlow)" text-anchor="middle" letter-spacing="6">INDIAN</text>
    <!-- Flourish curve on A -->
    <path d="M11,-16 C15,-2 21,3 27,3" stroke="url(#logoGold)" stroke-width="2.5" fill="none" stroke-linecap="round"/>
  </g>

  <!-- Bottom: EDIT flanked by gold lines -->
  <line x1="120" y1="112" x2="200" y2="112" stroke="url(#logoGold)" stroke-width="1.8"/>
  <text x="250" y="117" font-family="'Inter', 'Montserrat', sans-serif" font-size="15" font-weight="600" fill="url(#logoGold)" filter="url(#goldGlow)" text-anchor="middle" letter-spacing="10">EDIT</text>
  <line x1="300" y1="112" x2="380" y2="112" stroke="url(#logoGold)" stroke-width="1.8"/>
</svg>
